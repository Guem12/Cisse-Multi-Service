# Base de données
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Authentication
AUTH_SECRET=replace-with-a-random-secret

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Neon Object Storage
NEON_STORAGE_BUCKET=cisse-media
AWS_ENDPOINT_URL_S3=https://your-branch.storage.c-2.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=replace-with-neon-storage-credential-id
AWS_SECRET_ACCESS_KEY=replace-with-neon-storage-secret

# AI Gateway (Neon)
AI_GATEWAY_BASE_URL=https://your-gateway.example/v1/ai
AI_GATEWAY_API_KEY=replace-with-your-api-key
AI_DEFAULT_PROVIDER=openai

# Application
PUBLIC_SITE_URL=https://your-app.example
PUBLIC_WHATSAPP_1=YOUR_WHATSAPP_NUMBER
PUBLIC_WHATSAPP_2=YOUR_SECOND_WHATSAPP_NUMBER
