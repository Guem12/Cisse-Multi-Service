---
import AdminLayout from "../../layouts/AdminLayout.astro";
import DashboardStats from "../../../components/admin/DashboardStats.jsx";
import { getCategories, getProducts } from "../../../lib/data.js";
import { getHeroSelection } from "../../../lib/hero.js";
import { recordDashboardSnapshot } from "../../../lib/admin-dashboard.js";

export const prerender = false;

const [products, categories] = await Promise.all([
  getProducts({ includeInactive: true }),
  getCategories(),
]);
const heroSelection = await getHeroSelection(products);
const history = await recordDashboardSnapshot(products);
---

<AdminLayout title="Tableau de bord · Cissé Multi-Service">
  <DashboardStats client:load products={products} categories={categories} heroSelection={heroSelection} history={history} />
</AdminLayout>
