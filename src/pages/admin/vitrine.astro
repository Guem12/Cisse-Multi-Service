---
import AdminLayout from "../../layouts/AdminLayout.astro";
import HeroShowcaseManager from "../../../components/admin/HeroShowcaseManager.jsx";
import { getProducts } from "../../../lib/data.js";
import { getHeroShowcase } from "../../../lib/hero.js";

export const prerender = false;
const products = await getProducts({ includeInactive: true });
const initialSlots = await getHeroShowcase(products);
---

<AdminLayout title="Photos flottantes · Cissé Multi-Service">
  <HeroShowcaseManager client:load initialSlots={initialSlots} products={products} />
</AdminLayout>
