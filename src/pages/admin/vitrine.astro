---
import AdminLayout from "../../layouts/AdminLayout.astro";
import HeroSpotlightManager from "../../../components/admin/HeroSpotlightManager.jsx";
import { getProducts } from "../../../lib/data.js";
import { getHeroSelection } from "../../../lib/hero.js";

export const prerender = false;
const products = await getProducts({ includeInactive: true });
const initialSelection = await getHeroSelection(products);
---

<AdminLayout title="Produit à la une · Cissé Multi-Service">
  <HeroSpotlightManager client:load initialSelection={initialSelection} products={products} />
</AdminLayout>
