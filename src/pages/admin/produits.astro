---
import AdminLayout from "../../layouts/AdminLayout.astro";
import ProductList from "../../../components/admin/ProductList.jsx";
import { getCategories, getProducts } from "../../../lib/data.js";

export const prerender = false;
const [products, categories] = await Promise.all([
  getProducts({ includeInactive: true }),
  getCategories(),
]);
const initialStockFilter = Astro.url.searchParams.get("stock") === "alertes" ? "alertes" : "all";
---

<AdminLayout title="Catalogue Produits · Cissé Multi-Service">
  <ProductList client:load initialProducts={products} categories={categories} initialStockFilter={initialStockFilter} />
</AdminLayout>
