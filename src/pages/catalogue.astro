---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import CatalogOrderBar from "../../components/CatalogOrderBar.jsx";
import { getProductPage, getStorefrontFacts } from "../../lib/data.js";
import { PRICE_BANDS, SORTS, getVisibleStorefrontCategories, parsePriceBand } from "../../lib/store.js";

export const prerender = false;

const params = Astro.url.searchParams;
const active = params.get("categorie") || "";
const query = (params.get("q") || "").trim().slice(0, 80);
const priceBand = PRICE_BANDS.some((band) => band.value === params.get("prix")) ? params.get("prix") : "";
const sort = SORTS.some((item) => item.value === params.get("tri")) ? params.get("tri") : "recent";
const parsedPage = Number.parseInt(params.get("page") || "1", 10);
const page = Number.isSafeInteger(parsedPage) && parsedPage > 0 ? parsedPage : 1;
const pageSize = 12;
const { minPrice, maxPrice } = parsePriceBand(priceBand);
const phone = import.meta.env.PUBLIC_WHATSAPP_1 || "22362823995";

const pageHref = (nextPage, overrides = {}) => {
  const next = new URLSearchParams();
  const categorie = overrides.categorie ?? active;
  const q = overrides.q ?? query;
  const prix = overrides.prix ?? priceBand;
  const tri = overrides.tri ?? sort;
  if (categorie) next.set("categorie", categorie);
  if (q) next.set("q", q);
  if (prix) next.set("prix", prix);
  if (tri && tri !== "recent") next.set("tri", tri);
  if (nextPage > 1) next.set("page", String(nextPage));
  const search = next.toString();
  return search ? `/catalogue?${search}` : "/catalogue";
};

const [facts, products] = await Promise.all([
  getStorefrontFacts(),
  getProductPage({ categorySlug: active || undefined, query, minPrice, maxPrice, sort, page, pageSize }),
]);
const categories = getVisibleStorefrontCategories(facts.categories);
if (products.pageCount > 0 && page > products.pageCount) {
  return Astro.redirect(pageHref(products.pageCount), 302);
}
const currentCategory = categories.find((category) => category.slug === active);
const title = currentCategory
  ? `${currentCategory.name} · Cissé Multi-Service`
  : "Catalogue · Cissé Multi-Service";
const description = currentCategory
  ? `${currentCategory.name} en vente chez Cissé Multi-Service à Bamako. Commande par WhatsApp.`
  : "Catalogue Cissé Multi-Service à Bamako : sacs, montres et accessoires disponibles. Commande par WhatsApp.";
const filtersOn = Boolean(query || priceBand || (sort && sort !== "recent") || active);
---

<SiteLayout title={title} description={description}>
  <div class="wrap pb-16">
    <h1 class="mt-8 text-center font-titre text-4xl font-extrabold text-page-main sm:text-5xl">
      {currentCategory ? currentCategory.name : "Catalogue"}
    </h1>
    <p class="mx-auto mt-2 max-w-2xl text-center text-page-muted">Choisissez vos articles, puis commandez sur WhatsApp.</p>

    <form id="catalogue-filters" method="get" action="/catalogue" class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.3fr)_repeat(3,minmax(0,1fr))_auto]" role="search">
      <label class="block min-w-0 text-center text-sm font-semibold text-page-main">
        Recherche
        <input class="field mt-1 min-h-12 w-full" type="search" name="q" value={query} maxlength="80" placeholder="Nom ou description" />
      </label>
      <label class="block min-w-0 text-center text-sm font-semibold text-page-main">
        Catégorie
        <select class="field mt-1 min-h-12 w-full" name="categorie">
          <option value="" selected={!active}>Toutes les catégories</option>
          {categories.map((category) => <option value={category.slug} selected={active === category.slug}>{category.name}</option>)}
        </select>
      </label>
      <label class="block min-w-0 text-center text-sm font-semibold text-page-main">
        Prix
        <select class="field mt-1 min-h-12 w-full" name="prix">
          {PRICE_BANDS.map((band) => <option value={band.value} selected={priceBand === band.value}>{band.label}</option>)}
        </select>
      </label>
      <label class="block min-w-0 text-center text-sm font-semibold text-page-main">
        Trier
        <select class="field mt-1 min-h-12 w-full" name="tri">
          {SORTS.map((item) => <option value={item.value} selected={sort === item.value}>{item.label}</option>)}
        </select>
      </label>
      {filtersOn && <a href="/catalogue" class="inline-flex min-h-12 items-center justify-center rounded-full border px-4 text-sm font-semibold" style="border-color: var(--border);">Réinitialiser</a>}
    </form>

    {products.items.length === 0 ? (
      <div class="mt-8 text-center">
        <p class="text-page-muted">Aucun article trouvé.</p>
        <a href="/catalogue" class="mt-2 inline-block text-sm font-semibold text-indigo hover:underline dark:text-ocre">Effacer les filtres</a>
      </div>
    ) : (
      <>
        <p class="mt-4 text-center text-sm text-page-muted">{products.total} article{products.total > 1 ? "s" : ""}</p>
        <div class="mt-4 grid grid-cols-2 gap-x-3 gap-y-7 lg:grid-cols-4">
          {products.items.map((product, index) => (
            <ProductCard
              product={product}
              centered
              featuredGrid
              eager={index < 4}
              imageSizes="(min-width: 1024px) 214px, (min-width: 640px) calc(50vw - 48px), calc(50vw - 40px)"
            />
          ))}
        </div>
        {products.pageCount > 1 && (
          <nav class="mt-10 flex items-center justify-center gap-4" aria-label="Pagination du catalogue">
            {page > 1 ? (
              <a href={pageHref(page - 1)} rel="prev" class="rounded-full border px-4 py-2 text-sm font-semibold" style="border-color: var(--border);">Précédent</a>
            ) : (
              <span class="rounded-full border px-4 py-2 text-sm text-page-faint" style="border-color: var(--border);">Précédent</span>
            )}
            <span class="text-sm font-semibold text-page-muted">Page {page} sur {products.pageCount}</span>
            {page < products.pageCount ? (
              <a href={pageHref(page + 1)} rel="next" class="rounded-full border px-4 py-2 text-sm font-semibold" style="border-color: var(--border);">Suivant</a>
            ) : (
              <span class="rounded-full border px-4 py-2 text-sm text-page-faint" style="border-color: var(--border);">Suivant</span>
            )}
          </nav>
        )}
      </>
    )}
  </div>
  <CatalogOrderBar client:load phone={phone} />
</SiteLayout>

<script>
  const form = document.querySelector("#catalogue-filters");
  if (!(form instanceof HTMLFormElement)) {
    throw new Error("Le formulaire des filtres du catalogue est introuvable.");
  }

  const search = form.querySelector('input[name="q"]');
  let searchTimeout;

  function submitFilters() {
    window.clearTimeout(searchTimeout);
    if (typeof form.requestSubmit === "function") {
      form.requestSubmit();
    } else {
      form.submit();
    }
  }

  search?.addEventListener("input", () => {
    window.clearTimeout(searchTimeout);
    searchTimeout = window.setTimeout(submitFilters, 300);
  });

  form.querySelectorAll("select").forEach((select) => {
    select.addEventListener("change", submitFilters);
  });

  form.addEventListener("submit", () => window.clearTimeout(searchTimeout));
</script>
