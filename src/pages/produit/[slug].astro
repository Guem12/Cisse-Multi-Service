---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProductGallery from "../../../components/ProductGallery.jsx";
import WhatsAppOrder from "../../../components/WhatsAppOrder.jsx";
import { getProductBySlug } from "../../../lib/data.js";
import { formatPrice } from "../../../lib/format.js";

export const prerender = false;

const product = await getProductBySlug(Astro.params.slug);
if (!product) Astro.response.status = 404;

const title = product ? `${product.name} · Cissé Multi-Service` : "Produit introuvable · Cissé Multi-Service";
const categoryLink = product?.category?.slug
  ? `/catalogue?categorie=${encodeURIComponent(product.category.slug)}`
  : "/catalogue";
const inStock = Boolean(product && product.stock > 0);
---

<SiteLayout title={title} description={product?.description?.slice(0, 150) || title}>
  {!product ? (
    <div class="px-4 py-20 text-center">
      <h1 class="text-3xl font-extrabold">Page introuvable</h1>
      <p class="mt-2 text-indigo/70">Ce produit n'existe plus ou le lien est incorrect.</p>
      <a href="/catalogue" class="btn-primary mt-6 inline-block">Voir le catalogue</a>
    </div>
  ) : (
    <div class="min-h-screen bg-paper pb-16 transition-colors duration-200 dark:bg-indigo-deep">
      <div class="wrap pb-2 pt-4 sm:pt-6">
        <nav class="flex gap-2 overflow-x-auto whitespace-nowrap text-xs text-indigo/60 sm:text-sm dark:text-white/60" aria-label="Fil d'Ariane">
          <a href="/" class="transition-colors hover:text-indigo-deep dark:hover:text-white">Accueil</a>
          <span>›</span>
          <a href="/catalogue" class="transition-colors hover:text-indigo-deep dark:hover:text-white">Catalogue complet</a>
          {product.category?.name && (
            <>
              <span>›</span>
              <a href={categoryLink} class="font-medium text-indigo-deep transition-colors hover:text-indigo dark:text-white">{product.category.name}</a>
            </>
          )}
        </nav>
      </div>
      <article class="wrap grid items-start gap-8 pt-2 md:grid-cols-2 md:gap-10 lg:gap-14">
        <ProductGallery client:load images={product.images} name={product.name} inStock={inStock} />
        <div class="flex flex-col">
          {product.category?.name && <a href={categoryLink} class="w-fit text-xs font-extrabold uppercase tracking-widest text-emerald-600 transition-colors hover:text-emerald-700 dark:text-emerald-400">{product.category.name}</a>}
          <h1 class="mt-1 font-titre text-2xl font-extrabold leading-tight text-indigo-deep sm:text-3xl lg:text-4xl dark:text-white">{product.name}</h1>
          {product.description && <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-indigo-deep/80 sm:text-base dark:text-white/80">{product.description}</p>}
          {inStock && product.stock <= 5 && <p class="mt-3 inline-flex w-fit items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700 dark:border-amber-400/30 dark:bg-amber-950/40 dark:text-amber-300"><span>⚠️</span> Plus que {product.stock} en stock !</p>}
          <div class="mt-6 flex flex-wrap items-end justify-between gap-4 rounded-2xl border border-indigo/10 bg-white p-4 shadow-sm dark:border-white/10 dark:bg-[#141D3D]">
            <div>
              <p class="mb-0.5 text-[11px] font-extrabold uppercase tracking-widest text-indigo/50 dark:text-white/50">Prix spécial</p>
              <p class="font-titre text-3xl font-extrabold leading-none text-emerald-600 dark:text-emerald-400">{formatPrice(product.price)}</p>
            </div>
            <div class="flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3.5 py-1.5 text-xs font-semibold text-amber-800 shadow-sm sm:text-sm dark:border-amber-400/30 dark:bg-amber-950/40 dark:text-amber-300">
              <span class="text-base">🚚</span><span>Prix de livraison selon trajet</span>
            </div>
          </div>
          <WhatsAppOrder client:load name={product.name} price={product.price} stock={product.stock} slug={product.slug} image={product.images?.[0]?.url} />
        </div>
      </article>
    </div>
  )}
</SiteLayout>
