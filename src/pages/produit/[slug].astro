---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ProductGallery from "../../../components/ProductGallery.jsx";
import ProductCard from "../../../components/ProductCard.astro";
import WhatsAppOrder from "../../../components/WhatsAppOrder.jsx";
import { getProductBySlug, getSimilarProducts } from "../../../lib/data.js";
import { formatPrice } from "../../../lib/format.js";
import { BRAND, absoluteUrl, isLowStock, siteOrigin } from "../../../lib/store.js";

export const prerender = false;

const product = await getProductBySlug(Astro.params.slug);
if (!product) Astro.response.status = 404;

const title = product ? `${product.name} · ${BRAND}` : `Produit introuvable · ${BRAND}`;
const productSummary = product?.description?.replace(/\s+/g, " ").trim().slice(0, 120);
const description = product
  ? `${productSummary ? `${productSummary} · ` : ""}${product.name} disponible à Bamako chez ${BRAND}.`
  : title;
const categoryLink = product?.category?.slug
  ? `/catalogue?categorie=${encodeURIComponent(product.category.slug)}`
  : "/catalogue";
const inStock = Boolean(product && product.stock > 0);
const similar = product ? await getSimilarProducts(product, 4) : [];
const origin = siteOrigin();
const image = product?.images?.[0]?.url ? absoluteUrl(product.images[0].url, origin) : undefined;
const productJsonLd = product
  ? {
      "@type": "Product",
      name: product.name,
      description: product.description || product.name,
      sku: product.slug,
      image: (product.images || []).map((item) => absoluteUrl(item.url, origin)).filter(Boolean),
      brand: { "@type": "Brand", name: BRAND },
      offers: {
        "@type": "Offer",
        url: absoluteUrl(`/produit/${product.slug}`, origin),
        priceCurrency: "XOF",
        price: Number(product.price),
        availability: inStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
        seller: { "@type": "Organization", name: BRAND },
      },
    }
  : null;
---

<SiteLayout title={title} description={description} image={image} jsonLd={productJsonLd} orderBar={Boolean(product && inStock)}>
  {!product ? (
    <div class="px-4 py-20 text-center">
      <h1 class="text-3xl font-extrabold">Page introuvable</h1>
      <p class="mt-2 text-page-muted">Ce produit n'existe plus ou le lien est incorrect.</p>
      <a href="/catalogue" class="btn-primary mt-6 inline-block">Voir le catalogue</a>
    </div>
  ) : (
    <div class="min-h-screen pb-8">
      <div class="wrap pb-2 pt-4 sm:pt-6">
        <nav class="flex gap-2 overflow-x-auto whitespace-nowrap text-xs text-page-muted sm:text-sm" aria-label="Fil d'Ariane">
          <a href="/" class="hover:text-ocre">Accueil</a>
          <span aria-hidden="true">›</span>
          <a href="/catalogue" class="hover:text-ocre">Catalogue</a>
          {product.category?.name && (
            <>
              <span aria-hidden="true">›</span>
              <a href={categoryLink} class="font-medium text-page-main hover:text-ocre">{product.category.name}</a>
            </>
          )}
        </nav>
      </div>
      <article class="wrap grid items-start gap-8 pt-2 md:grid-cols-2 md:gap-10 lg:gap-14">
        <ProductGallery client:load images={product.images || []} name={product.name} stock={product.stock} />
        <div class="flex flex-col">
          {product.category?.name && <a href={categoryLink} class="w-fit text-xs font-extrabold uppercase tracking-widest text-ocre">{product.category.name}</a>}
          <h1 class="mt-1 font-titre text-2xl font-extrabold leading-tight text-page-main sm:text-3xl lg:text-4xl">{product.name}</h1>
          {product.description ? (
            <div class="mt-4">
              <h2 class="text-sm font-bold uppercase tracking-wide text-page-muted">Description</h2>
              <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-page-main sm:text-base">{product.description}</p>
            </div>
          ) : (
            <p class="mt-4 text-sm text-page-muted">La description de cet article sera ajoutée prochainement.</p>
          )}
          {isLowStock(product.stock) && <p class="mt-3 inline-flex w-fit rounded-full bg-ocre px-3 py-1 text-xs font-bold text-indigo-deep">Dernières pièces : {product.stock} en stock</p>}
          <div class="mt-6 flex flex-wrap items-end justify-between gap-4 rounded-2xl border p-4 shadow-sm" style="background: var(--bg-surface); border-color: var(--border);">
            <div>
              <p class="mb-0.5 text-[11px] font-extrabold uppercase tracking-widest text-page-muted">Prix</p>
              <p class="font-titre text-3xl font-extrabold leading-none text-page-main">{formatPrice(product.price)}</p>
            </div>
            <p class="rounded-full border border-ocre/40 bg-ocre/15 px-3.5 py-1.5 text-xs font-semibold text-page-main sm:text-sm">Livraison selon le trajet</p>
          </div>
          <WhatsAppOrder client:load name={product.name} price={product.price} stock={product.stock} slug={product.slug} image={product.images?.[0]?.url} variants={product.variants || []} />
        </div>
      </article>
      {similar.length > 0 && (
        <section class="wrap mt-14" aria-labelledby="similaires-titre">
          <h2 id="similaires-titre" class="font-titre text-2xl font-bold text-page-main">Produits similaires</h2>
          <div class="mt-4 grid grid-cols-2 gap-x-3 gap-y-7 lg:grid-cols-4">
            {similar.map((item) => <ProductCard product={item} />)}
          </div>
        </section>
      )}
    </div>
  )}
</SiteLayout>
