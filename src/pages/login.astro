---
import SiteLayout from "../layouts/SiteLayout.astro";

const callbackCandidate = Astro.url.searchParams.get("callbackUrl") || "/admin";
const callbackUrl = callbackCandidate.startsWith("/") && !callbackCandidate.startsWith("//")
  ? callbackCandidate
  : "/admin";
const error = Astro.url.searchParams.get("error");
---

<SiteLayout title="Connexion administrateur · Cissé Multi-Service" chrome={false} noindex={true}>
  <div class="admin-login-page">
    <div class="admin-grid"></div>
    <div class="orb-1"></div>
    <div class="orb-2"></div>
    <div class="glass-card">
      <div class="top-bar"></div>
      <div class="card-body">
        <div class="mb-8 text-center">
          <img src="/icon-blanc.svg" alt="" width="56" height="56" class="mx-auto mb-4 rounded-2xl bg-indigo p-2" />
          <p class="mb-2 inline-flex rounded-full border border-ocre/20 bg-ocre/10 px-3 py-1 text-xs font-bold uppercase tracking-wider text-ocre">Espace sécurisé</p>
          <h1 class="font-titre text-2xl font-extrabold text-white">Administration</h1>
          <p class="mt-1 text-sm text-white/55">Connectez-vous pour gérer votre boutique.</p>
        </div>
        {error === "credentials" && <p role="alert" class="error-box mb-4">Email ou mot de passe incorrect.</p>}
        {error === "configuration" && <p role="alert" class="error-box mb-4">La connexion n’est pas configurée. Vérifiez la variable AUTH_SECRET.</p>}
        <form action="/api/auth/login" method="post" class="space-y-4">
          <input type="hidden" name="callbackUrl" value={callbackUrl} />
          <label class="block">
            <span class="lbl">Adresse e-mail</span>
            <input class="input-admin" type="email" name="email" autocomplete="username" required />
          </label>
          <label class="block">
            <span class="lbl">Mot de passe</span>
            <input class="input-admin" type="password" name="password" autocomplete="current-password" required />
          </label>
          <button type="submit" class="btn-submit">Se connecter</button>
        </form>
        <a href="/" class="mt-6 block text-center text-sm text-white/60 hover:text-white">Retour à la boutique</a>
      </div>
    </div>
  </div>
</SiteLayout>

<style>
  .admin-login-page {
    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #060c1e, #0a1128 50%, #0e1530);
    padding: 24px 16px;
  }
  .admin-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
    background-size: 48px 48px;
  }
  .orb-1, .orb-2 { position: absolute; border-radius: 50%; pointer-events: none; filter: blur(80px); }
  .orb-1 { top: 20%; left: 15%; width: 320px; height: 320px; background: rgba(99,102,241,.08); }
  .orb-2 { bottom: 15%; right: 15%; width: 300px; height: 300px; background: rgba(224,160,48,.07); }
  .glass-card { width: 100%; max-width: 440px; border: 1px solid rgba(255,255,255,.08); border-radius: 24px; background: rgba(13,20,40,.92); box-shadow: 0 32px 80px rgba(0,0,0,.6); position: relative; z-index: 1; }
  .top-bar { height: 3px; border-radius: 24px 24px 0 0; background: linear-gradient(90deg, #6366f1, #e0a030, #10b981); }
  .card-body { padding: 36px 40px; }
  .lbl { display: block; margin-bottom: 6px; color: rgba(255,255,255,.55); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .input-admin { width: 100%; box-sizing: border-box; border: 1px solid rgba(255,255,255,.1); border-radius: 12px; background: rgba(255,255,255,.05); padding: 13px 16px; color: #f0f2fa; font-size: 14px; outline: none; }
  .input-admin:focus { border-color: rgba(224,160,48,.6); box-shadow: 0 0 0 3px rgba(224,160,48,.1); }
  .btn-submit { width: 100%; border: 0; border-radius: 12px; background: linear-gradient(135deg,#e0a030,#c8901f); padding: 14px; color: #0e1530; font-size: 14px; font-weight: 700; cursor: pointer; }
  .error-box { border: 1px solid rgba(239,68,68,.25); border-radius: 12px; background: rgba(239,68,68,.1); padding: 12px 14px; color: #f87171; font-size: 13px; }
  @media (max-width: 480px) { .card-body { padding: 28px 24px; } }
</style>
