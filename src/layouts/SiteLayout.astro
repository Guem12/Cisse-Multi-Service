---
import "../styles/global.css";
import Navbar from "../../components/Navbar.jsx";
import { formatPhone } from "../../lib/format.js";
import {
  BRAND,
  DEFAULT_OG_IMAGE,
  DEFAULT_TITLE,
  WHATSAPP_GREETING,
  absoluteUrl,
  jsonLdScript,
  siteOrigin,
  waLink,
} from "../../lib/store.js";

const {
  title = DEFAULT_TITLE,
  description = "Cissé Multi-Service, boutique à Bamako : sacs, montres et accessoires. Commande par WhatsApp, livraison selon le trajet.",
  image = DEFAULT_OG_IMAGE,
  chrome = true,
  noindex = false,
  jsonLd = null,
  orderBar = false,
} = Astro.props;

Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=30, stale-while-revalidate=120");

const numbers = [import.meta.env.PUBLIC_WHATSAPP_1, import.meta.env.PUBLIC_WHATSAPP_2].filter(Boolean);
const whatsappNumbers = numbers.length ? numbers : ["22362823995", "22373082453"];
const callNumber = String(import.meta.env.PUBLIC_CALL_PHONE || whatsappNumbers[0]).replace(/\D/g, "");
const socialLinks = [
  ["Instagram", import.meta.env.PUBLIC_INSTAGRAM_URL],
  ["Facebook", import.meta.env.PUBLIC_FACEBOOK_URL],
  ["TikTok", import.meta.env.PUBLIC_TIKTOK_URL],
].filter(([, value]) => {
  try {
    return new URL(value).protocol === "https:";
  } catch {
    return false;
  }
});
const plausibleDomain = String(import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || "").trim();
const plausibleEnabled = /^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?\.[a-z]{2,}$/i.test(plausibleDomain);
const origin = siteOrigin();
const canonical = absoluteUrl(Astro.url.pathname || "/", origin);
const socialImage = absoluteUrl(image, origin);
const localBusiness = {
  "@type": "LocalBusiness",
  name: BRAND,
  url: origin,
  image: socialImage,
  telephone: `+${callNumber}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bamako",
    addressCountry: "ML",
  },
  areaServed: "Bamako",
};
const graph = [localBusiness, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : <link rel="canonical" href={canonical} />}
    {!noindex && (
      <>
        <meta property="og:locale" content="fr_ML" />
        <meta property="og:site_name" content={BRAND} />
        <meta property="og:type" content={jsonLd?.["@type"] === "Product" ? "product" : "website"} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
        <script type="application/ld+json" set:html={jsonLdScript({ "@context": "https://schema.org", "@graph": graph })} />
      </>
    )}
    <link rel="icon" href="/logo-icon.svg" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    {plausibleEnabled && (
      <>
        <script defer data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
        <script is:inline>
          {`
            document.addEventListener("click", (event) => {
              const link = event.target.closest('a[href^="https://wa.me/"]');
              if (link && window.plausible) window.plausible("WhatsApp Click");
            });
            window.addEventListener("cisse_whatsapp_order", (event) => {
              if (window.plausible) window.plausible("WhatsApp Order", { props: { count: event.detail.count, value: event.detail.value } });
            });
          `}
        </script>
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400..800&family=Figtree:wght@400..800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const theme = localStorage.getItem("cisse_theme");
        const dark = theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      } catch {}
    </script>
  </head>
  <body
    class:list={["flex min-h-screen flex-col transition-colors duration-300", chrome ? "pb-[calc(3.25rem+env(safe-area-inset-bottom))] lg:pb-0" : ""]}
    style="background-color: var(--bg-page); color: var(--text-main); --font-titre: 'Bricolage Grotesque'; --font-main: 'Figtree';"
  >
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    {chrome && <Navbar client:load />}
    <main id="contenu" class="flex-1"><slot /></main>
    {
      chrome && (
        <footer class="border-t border-white/10 bg-[#0A1230] text-white dark:bg-[#020710]">
          <div class="wrap py-8">
            <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
              <div>
                <img src="/logo-fond-sombre.svg" alt={BRAND} width="110" height="40" class="h-8 w-auto sm:h-9" />
                <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/75">{description}</p>
              </div>
              <nav aria-label="Informations" class="flex flex-col gap-2 text-sm">
                <span class="text-[11px] font-bold uppercase tracking-wider text-ocre">Boutique</span>
                <a href="/catalogue" class="w-fit text-white/80 hover:text-white">Catalogue</a>
                <a href="/qui-sommes-nous" class="w-fit text-white/80 hover:text-white">Qui sommes-nous</a>
                <a href="/livraison-paiement" class="w-fit text-white/80 hover:text-white">Livraison et paiement</a>
                <a href="/retours-echanges" class="w-fit text-white/80 hover:text-white">Retours et échanges</a>
                <a href="/#faq" class="w-fit text-white/80 hover:text-white">Questions fréquentes</a>
              </nav>
              <div class="flex flex-col gap-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-ocre">Contact WhatsApp</span>
                <div class="flex flex-wrap gap-2">
                  {whatsappNumbers.map((number) => (
                    <a href={waLink(number)} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/30 px-3.5 py-2 text-sm font-medium transition-colors hover:border-ocre hover:text-ocre">
                      WhatsApp {formatPhone(number)}
                    </a>
                  ))}
                </div>
                <p class="text-sm text-white/70">Bamako, Mali. L'adresse de retrait et les horaires sont confirmés sur WhatsApp.</p>
                <a href={`tel:+${callNumber}`} class="w-fit rounded-full border border-white/30 px-3.5 py-2 text-sm font-semibold text-white/90 hover:border-ocre hover:text-ocre">Appeler {formatPhone(callNumber)}</a>
                {socialLinks.length > 0 && (
                  <nav class="mt-1 flex flex-wrap gap-3 text-sm" aria-label="Réseaux sociaux">
                    {socialLinks.map(([label, url]) => <a href={url} target="_blank" rel="noopener noreferrer" class="text-white/80 underline-offset-2 hover:text-white hover:underline">{label}</a>)}
                  </nav>
                )}
              </div>
            </div>
            <div class="mt-6 flex flex-col gap-1 border-t border-white/10 pt-4 text-xs text-white/50 sm:flex-row sm:items-center sm:justify-between">
              <p>© {new Date().getFullYear()} {BRAND} · Bamako, Mali</p>
              <p>Tous droits réservés</p>
            </div>
          </div>
        </footer>
      )
    }
    {
      chrome && (
        <a
          href={waLink(whatsappNumbers[0])}
          target="_blank"
          rel="noopener noreferrer"
          class:list={["fixed right-4 z-30 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#128C7E] text-white shadow-lg transition hover:bg-[#0d6e63] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ocre", orderBar ? "bottom-36 lg:bottom-5" : "bottom-20 lg:bottom-5"]}
          aria-label={`Écrire à ${BRAND} sur WhatsApp`}
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-7 w-7" aria-hidden="true">
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.122 1.532 5.855L.057 23.47a.5.5 0 0 0 .606.638l5.805-1.524A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.94 9.94 0 0 1-5.07-1.39l-.36-.21-3.45.9.92-3.36-.23-.37A9.96 9.96 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z" />
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z" />
          </svg>
          <span class="sr-only">{WHATSAPP_GREETING}</span>
        </a>
      )
    }
  </body>
</html>
