---
import "../styles/global.css";
import AdminNotifications from "../../components/admin/AdminNotifications.jsx";
import AdminProfileSettings from "../../components/admin/AdminProfileSettings.jsx";
import SignOutButton from "../../components/admin/SignOutButton.jsx";

const { title = "Administration · Cissé Multi-Service" } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: "/admin", label: "Tableau de bord" },
  { href: "/admin/produits", label: "Produits" },
  { href: "/admin/categories", label: "Catégories" },
  { href: "/admin/clients", label: "Clients" },
  { href: "/admin/vitrine", label: "Vitrine d’accueil" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href="/logo-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400..800&family=Figtree:wght@400..800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem("cisse_theme");
        const dark = theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      } catch {}
    </script>
  </head>
  <body class="min-h-screen font-sans" style="--font-titre: 'Bricolage Grotesque'; --font-main: 'Figtree'; background: var(--bg-subtle); color: var(--text-main);">
    <div class="min-h-screen lg:flex">
      <aside class="bg-indigo-deep text-white lg:fixed lg:inset-y-0 lg:w-64">
        <div class="flex items-center justify-between border-b border-white/10 p-4">
          <a href="/admin" class="font-titre text-lg font-extrabold">Cissé · Admin</a>
          <a href="/" class="text-xs text-white/70 hover:text-white">Boutique</a>
        </div>
        <nav aria-label="Administration" class="flex gap-1 overflow-x-auto p-3 lg:flex-col">
          {links.map(({ href, label }) => (
            <a
              href={href}
              aria-current={path === href ? "page" : undefined}
              class:list={[
                "shrink-0 rounded-lg px-3 py-2.5 text-sm font-semibold transition-colors hover:bg-white/10",
                path === href ? "bg-white/15 text-ocre" : "text-white/75",
              ]}
            >
              {label}
            </a>
          ))}
          <a href="/admin/produits/nouveau" class="shrink-0 rounded-lg px-3 py-2.5 text-sm font-semibold text-white/75 transition-colors hover:bg-white/10">Ajouter un produit</a>
        </nav>
        <div class="hidden border-t border-white/10 p-4 lg:block">
          <SignOutButton client:load />
        </div>
      </aside>
      <div class="min-w-0 flex-1 lg:ml-64">
        <header class="sticky top-0 z-30 flex min-h-16 items-center justify-between gap-3 border-b px-4 backdrop-blur-md sm:px-8" style="background: var(--bg-surface); border-color: var(--border);">
          <div class="text-sm font-semibold">{title.replace(" · Cissé Multi-Service", "")}</div>
          <div class="flex items-center gap-3">
            <AdminNotifications client:load />
            <button type="button" id="admin-theme-toggle" class="rounded-lg border px-3 py-2 text-xs font-bold" style="border-color: var(--border); background: var(--bg-subtle);">Thème</button>
            <AdminProfileSettings client:load />
          </div>
        </header>
        <main class="mx-auto w-full max-w-7xl p-4 sm:p-6 lg:p-8"><slot /></main>
      </div>
    </div>
    <script is:inline>
      document.getElementById("admin-theme-toggle")?.addEventListener("click", () => {
        const dark = !document.documentElement.classList.contains("dark");
        document.documentElement.classList.toggle("dark", dark);
        localStorage.setItem("cisse_theme", dark ? "dark" : "light");
      });
    </script>
  </body>
</html>
